# nginx 反向代理配置模板（yiban-auto-sign Web 管理后台）
#
# 2026-08-20 对抗性审查补充：应用侧 _client_ip() 仅在 remote_addr 为回环时信任
# X-Forwarded-For 的【第一个值】，安全性完全依赖本模板的"覆盖式"写法——
#   proxy_set_header X-Forwarded-For $remote_addr;
# ⚠️ 切勿改成网上教程常见的 $proxy_add_x_forwarded_for（追加式）：那会让客户端
# 自报的伪造值留在 XFF 首位，登录锁定/API 限速/注册限速全部按伪造 IP 分桶而失效。
#
# 用法：替换 server_name 与证书路径后放入 /etc/nginx/conf.d/ 或 sites-available，
# reload nginx。应用本身监听 127.0.0.1:17892（systemd 单元默认）。
#
# 【两种部署形态，二选一】
#   形态 A（下方 server 块）：应用占独立域名/子域根路径（如 yiban.example.com）。
#   形态 B（文件末尾子路径块）：作为主站子页面（如 example.com/tools/yiban-auto-sign/demo/）。
# 应用侧 BasePathMiddleware 会自动识别挂载前缀，两种形态都无需改应用代码。
# ⚠️ 关键契约：proxy_pass 后【不要加 "/"】——加 "/" 会剥掉 URI 前缀，自动识别失效
#   （此时只能靠 .env 的 YIBAN_BASE_PATH 显式指定前缀，见 README「部署形态」章节）。
# 静态资源由应用自带 /static 提供（30 天缓存 + ?v= 版本号），子路径形态也无需单独配静态。

# 批次7 P3-20：边缘限速——应用内限速仅覆盖登录/注册等端点，慢速泛洪
# 可占满 gunicorn 单 worker 8 线程池；管理后台正常使用远低于此阈值
limit_req_zone $binary_remote_addr zone=yiban_perip:10m rate=20r/s;

server {
    # http2 写在 listen 行（旧语法，nginx ≥1.9.5 全兼容；`http2 on;` 新语法需 ≥1.25.1，
    # Ubuntu 20.04/22.04 LTS 随附的 1.18 不支持会导致 nginx -t 失败）
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name yiban.example.com;          # ← 改成你的域名

    # TLS 证书（Let's Encrypt / acme.sh 签发的路径）
    ssl_certificate     /etc/ssl/yiban/fullchain.pem;   # ← 改成你的证书路径
    ssl_certificate_key /etc/ssl/yiban/key.pem;         # ← 改成你的私钥路径
    ssl_protocols TLSv1.2 TLSv1.3;

    # HSTS 阶梯启用指引（v0.24.4）：
    #   自签证书期：保持 max-age=0（不发 HSTS），避免浏览器被锁死在证书报错页；
    #   换用受信证书（Let's Encrypt / 云厂商 DV 等）后，按阶梯放开——
    #     第 1 天观察期: add_header Strict-Transport-Security "max-age=86400" always;
    #     稳定后加码:    add_header Strict-Transport-Security "max-age=2592000" always;
    #     最终形态:      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    #   注意 nginx 的 add_header 不跨级继承：若下方 location 内出现任意 add_header，
    #   此行需在该 location 内重申。
    # add_header Strict-Transport-Security "max-age=86400" always;

    # 管理后台仅一人使用，无需大上传体；64KB 与应用 MAX_CONTENT_LENGTH 对齐
    client_max_body_size 64k;

    location / {
        limit_req zone=yiban_perip burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:17892;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # ↓↓↓ 关键：覆盖式 XFF（丢弃客户端自报值），应用按此取真实客户端 IP
        proxy_set_header X-Forwarded-For $remote_addr;
        # 应用据此判定 HTTPS（下发 HSTS、Secure Cookie 场景）
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
    }

    # 可选：HTTP 跳转 HTTPS
    # server { listen 80; server_name yiban.example.com;
    #          return 301 https://$host$request_uri; }
}


# ===========================================================================
# 形态 B：作为主站子页面部署（在【主站自己的 nginx】里加这个 location 即可）
#   访问 https://example.com/tools/yiban-auto-sign/demo/login → 应用 /login
# ===========================================================================
# server {
#     listen 443 ssl http2;
#     server_name example.com;              # ← 主站域名
#     ssl_certificate     /etc/ssl/example/fullchain.pem;
#     ssl_certificate_key /etc/ssl/example/key.pem;
#
#     # 关键：proxy_pass 后【不加 "/"】，完整 URI 原样透传，应用自动识别前缀
#     location /tools/yiban-auto-sign/demo/ {
#         proxy_pass http://127.0.0.1:17892;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $remote_addr;   # 覆盖式（勿用追加式）
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
#
#     # 可选优化：静态资源边缘直发（绕过 Python，降低应用压力；必须与 ?v= 版本号配套）
#     # location /tools/yiban-auto-sign/demo/static/ {
#     #     alias /opt/yiban-auto-sign/web/static/;
#     #     expires 30d;
#     #     add_header Cache-Control "public, immutable";
#     # }
#
#     # 可选：子路径首页无尾斜杠时补斜杠（避免落到应用 404）
#     # location = /tools/yiban-auto-sign/demo { return 301 /tools/yiban-auto-sign/demo/; }
# }
