# ============================================================
# yiban-web.service —— 易班自动签到 Web 控制台 systemd 单元模板
# ============================================================
# 安装：
#   sudo cp web/deploy/yiban-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now yiban-web
#
# 前提：
#   1. 应用监听 127.0.0.1:17892，由 nginx 反代对外提供 443 HTTPS，
#      17892 不对公网开放（防火墙仅放行 22/443）。
#   2. /etc/yiban/accounts-key 为密钥文件（0600，属主 root:yiban），
#      由 systemd 注入为环境变量（web/app.py 会通过 .env / 环境变量读取）。
#      若服务器不使用该密钥文件，可删除 EnvironmentFile 一行，
#      并确保 /opt/yiban-auto-sign/.env 中 YIBAN_SECRET_KEY 已配置。
#
# gunicorn 安装二选一（本模板默认用虚拟环境 .venv/bin/gunicorn）：
#   方式 A（推荐，隔离依赖）：cd /opt/yiban-auto-sign && python3 -m venv .venv \
#         && .venv/bin/pip install -r requirements.txt gunicorn
#   方式 B（系统级）：sudo apt-get install -y gunicorn3
#         （Debian/Ubuntu 的包名为 gunicorn3，可执行文件为 /usr/bin/gunicorn3；
#          若通过 pipx/pip 全局安装 gunicorn，可执行文件为 /usr/bin/gunicorn）
# 两种方式只需保留下方 ExecStart 中与安装方式匹配的一行，删除另一行。

[Unit]
Description=Yiban auto-sign web console
After=network.target

[Service]
User=yiban
Group=yiban
WorkingDirectory=/opt/yiban-auto-sign
EnvironmentFile=/etc/yiban/accounts-key
# 注意：必须保持 -w 1（单 worker 多线程）。限速/爆破锁定/签到防抖等状态存于进程内存，
# 多 worker 各自持有独立副本会导致阈值被轮换请求绕过（安全审查 S2）。如需提升并发，
# 请调整 --threads 而非 --workers（gthread 线程共享进程内存）。
# 方式 A：虚拟环境安装（推荐，与项目依赖隔离；--no-control-socket 与生产一致，防控制 socket 暴露）
ExecStart=/opt/yiban-auto-sign/.venv/bin/gunicorn -w 1 --threads 8 --no-control-socket -b 127.0.0.1:17892 "web.app:create_app()"
# 方式 B：系统级 gunicorn（未创建 .venv 时使用；注意 Ubuntu 包名/可执行名为 gunicorn3）
# ExecStart=/usr/bin/gunicorn3 -w 1 --threads 8 --no-control-socket -b 127.0.0.1:17892 "web.app:create_app()"
# 方式 B（pip 全局安装）：ExecStart=/usr/bin/gunicorn -w 1 --threads 8 --no-control-socket -b 127.0.0.1:17892 "web.app:create_app()"
Restart=always
RestartSec=3
ProtectSystem=strict
ReadWritePaths=/opt/yiban-auto-sign /var/log/yiban
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
