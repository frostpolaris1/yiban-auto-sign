# ============================================================
# yiban-web.service —— 易班自动签到 Web 控制台 systemd 单元模板
# ============================================================
# 安装（本文件是**模板**：@YIBAN_*@ 占位符必须先按部署面值表渲染）：
#   set -a; . deploy/web.env; set +a
#   export YIBAN_APP_DIR="$(pwd)"        # 检出根（标准部署即 /opt/yiban-auto-sign）
#   sed -e "s|@YIBAN_APP_DIR@|$YIBAN_APP_DIR|g" \
#       -e "s|@YIBAN_WEB_PORT@|$YIBAN_WEB_PORT|g" \
#       -e "s|@YIBAN_WEB_THREADS@|$YIBAN_WEB_THREADS|g" \
#       web/deploy/yiban-web.service | sudo tee /etc/systemd/system/yiban-web.service >/dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now yiban-web
#
# 端口与线程数的唯一值表是 deploy/web.env；本文件不得写死这两个值（守卫：
# tests/test_deploy_parameterization_gate.py）。
#
# 前提：
#   1. 应用只监听回环地址的 @YIBAN_WEB_PORT@ 端口，由 nginx 反代对外提供 443 HTTPS，
#      该端口不对公网开放（防火墙仅放行 22/443）。
#   2. /etc/yiban/accounts-key 为密钥文件（0640，属主 root:yiban；组可读、他人不可读），
#      由 systemd 注入为环境变量（web/app.py 会通过 .env / 环境变量读取）。
#      若服务器不使用该密钥文件，可删除 EnvironmentFile 一行，
#      并确保 <检出>/data/.env 中 YIBAN_SECRET_KEY 已配置。
#      ⚠️ 轮换 YIBAN_ACCOUNTS_KEY 时必须同步改这份 EnvironmentFile 与 .env——
#      启动断言"两侧读到同一把钥"，不一致即拒绝启动（fail-closed，日志报两侧
#      kid），不再允许 env 静默压住 .env 造成 web/engine 分叉。见 README 处置节。
#
# gunicorn 安装二选一（本模板默认用虚拟环境 .venv/bin/gunicorn）：
#   方式 A（推荐，隔离依赖）：cd <检出> && python3 -m venv .venv \
#         && .venv/bin/pip install -r requirements.lock gunicorn
#   注：安装精确锁定的 requirements.lock（与 CI/Docker 镜像同源），
#       保证部署版本 = 安全审计覆盖的版本；requirements.txt 仅作下限声明。
#   方式 B（系统级）：sudo apt-get install -y gunicorn3
#         （Debian/Ubuntu 的包名为 gunicorn3，可执行文件为 /usr/bin/gunicorn3；
#          若通过 pipx/pip 全局安装 gunicorn，可执行文件为 /usr/bin/gunicorn）
# 两种方式只需保留下方 ExecStart 中与安装方式匹配的一行，删除另一行。

[Unit]
Description=Yiban auto-sign web console
After=network.target

[Service]
User=yiban
Group=yiban
WorkingDirectory=@YIBAN_APP_DIR@
EnvironmentFile=/etc/yiban/accounts-key
# 生产环境经 nginx HTTPS 反代，强制会话 Cookie 仅经 HTTPS 发送（H6）。
Environment=YIBAN_COOKIE_SECURE=1
# 转发头信任开关（M12 / 工单 ba-p07-01）：应用只在"来源是回环 + 本开关为开"时采信
# X-Forwarded-For。本单元的前提就是 nginx 反代（见文件头"前提 1"），nginx→应用恒为
# 回环并覆盖式重写 XFF——**必须置 1**，否则全站客户端会塌进 127.0.0.1 这一个桶：
# 限速、登录爆破计数、审计 IP 全部失真。缺省不信任（fail-closed）是给"回环直连 /
# ssh -L 隧道"那两种形态的，不是给生产反代的。
Environment=YIBAN_TRUST_FORWARDED_HEADERS=1
# 注意：必须保持 -w 1（单 worker 多线程）。限速/爆破锁定/签到防抖等状态存于进程内存，
# 多 worker 各自持有独立副本会导致阈值被轮换请求绕过（安全审查 S2）。如需提升并发，
# 请调整 --threads 而非 --workers（gthread 线程共享进程内存）。
# --threads 取 @YIBAN_WEB_THREADS@：SSE 长连接在 gthread 下各占一个线程，线程数不足时
# 新连接会饿死全站。档位理由与实测数据见 deploy/web.env 的注释。
# 方式 A：虚拟环境安装（推荐，与项目依赖隔离；--no-control-socket 与生产一致，防控制 socket 暴露）
ExecStart=@YIBAN_APP_DIR@/.venv/bin/gunicorn -w 1 --threads @YIBAN_WEB_THREADS@ --timeout 60 --no-control-socket -b 127.0.0.1:@YIBAN_WEB_PORT@ "web.app:create_app()"
# 方式 B：系统级 gunicorn（未创建 .venv 时使用；注意 Ubuntu 包名/可执行名为 gunicorn3）
# ExecStart=/usr/bin/gunicorn3 -w 1 --threads @YIBAN_WEB_THREADS@ --timeout 60 --no-control-socket -b 127.0.0.1:@YIBAN_WEB_PORT@ "web.app:create_app()"
# 方式 B（pip 全局安装）：ExecStart=/usr/bin/gunicorn -w 1 --threads @YIBAN_WEB_THREADS@ --timeout 60 --no-control-socket -b 127.0.0.1:@YIBAN_WEB_PORT@ "web.app:create_app()"
Restart=always
RestartSec=3
ProtectSystem=strict
ProtectHome=true
# 写入面：检出根仍需在 ReadWritePaths 里（ProtectSystem=strict 会把其余路径整个只读），
# 但**有效的**可写面只有检出内的 data/——检出根属 root 且组/其他不可写（install.sh 的
# M01 门要求），服务账号只能写 data/（属 yiban、0700，由 install.sh 建立）。运行数据
# （.env / yiban.db / 通知账本与节流表）都落在 data/ 下。
ReadWritePaths=@YIBAN_APP_DIR@ /var/log/yiban /var/lock/yiban
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
UMask=0077
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
