# ============================================================
# Go 服务端（server/）容器运行配置模板。
# ------------------------------------------------------------
# 一次性准备（在仓库根）：
#   cp deploy/container/compose.env.example deploy/container/compose.env
#   chmod 600 deploy/container/compose.env
#   填 POSTGRES_PASSWORD / YIBAN_HASH_PEPPER / YIBAN_CREDENTIAL_KEY
#   openssl rand -hex 32      # YIBAN_HASH_PEPPER
#   openssl rand -base64 32   # YIBAN_CREDENTIAL_KEY
#   openssl rand -hex 16      # POSTGRES_PASSWORD（数据库口令）
#
# 启动（必须显式 --env-file，不读取仓库根 .env）：
#   docker compose --env-file deploy/container/compose.env \
#     -f deploy/container/docker-compose.yml up -d --build
#
# 本文件入库：秘密键必须留空，不得写入任何真实值。
# 键面与 server/internal/configdata/registry.json 一致（测试钉住），
# 唯一例外：YIBAN_DATABASE_URL 由 docker-compose.yml 从 POSTGRES_PASSWORD
# 派生（口令只保留一处来源），故不在本文件出现。
# ============================================================

# ---- 部署 ----
YIBAN_ENV=production
YIBAN_ALLOW_NO_DB=0
YIBAN_HASH_PEPPER=
YIBAN_CREDENTIAL_KEY=
# 容器内必须监听全部接口：宿主只发布 127.0.0.1:8080。
YIBAN_HTTP_ADDR=0.0.0.0:8080
YIBAN_TZ=Asia/Shanghai
YIBAN_INSECURE_COOKIES=false
YIBAN_UI_DIR=/srv/ui
# 对外基址（绝对 http(s) URL，无尾斜杠）。TLS 在宿主反代终结时填公网 https 地址。
YIBAN_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---- 执行体 ----
YIBAN_WORKERS=1
YIBAN_AVG_ATTEMPT_SEC=3
YIBAN_EGRESS_RATE=1.0

# ---- 调度 ----
YIBAN_WINDOW_EDGE_FRONT_SEC=60
YIBAN_WINDOW_EDGE_BACK_SEC=60
YIBAN_ALLOW_TIME_PREF=false
YIBAN_TIME_PREF_COOLDOWN_SEC=30
YIBAN_TASK_LEASE_SEC=120

# ---- 节流 ----
YIBAN_RATE_LIMIT_ENABLE=true
YIBAN_RATE_IP_PER_MIN=60
YIBAN_RATE_IP_BURST=20
YIBAN_RATE_ACCOUNT_PER_MIN=10
YIBAN_RATE_ACCOUNT_BURST=5

# ---- 安全 ----
# Docker 发布端口经网桥网关转发：信任 Docker 默认网桥池与回环。
YIBAN_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
YIBAN_KDF_CONCURRENCY=4

# ---- 通知（口令重置邮件）----
YIBAN_RESET_MAIL_ENABLE=false
YIBAN_MAIL_SMTP_HOST=smtp.qq.com
YIBAN_MAIL_SMTP_PORT=465
YIBAN_MAIL_TLS_MODE=auto
# 秘密/联系信息：开启重置邮件时必填，本文件留空。
YIBAN_MAIL_USER=
YIBAN_MAIL_PASS=
YIBAN_MAIL_FROM=

# ---- webhook 推送（serverchan/custom）----
YIBAN_WEBHOOK_ENABLE=false
YIBAN_WEBHOOK_TYPE=serverchan
# 秘密：SendKey 或完整 webhook URL，本文件留空。
YIBAN_WEBHOOK_SECRET=
YIBAN_WEBHOOK_COOLDOWN_SEC=60
YIBAN_WEBHOOK_DAILY_MAX=5

# ---- 图片 ----
YIBAN_PHOTO_DIR=/data/photos
# 随机安全裁切（每边 0–10%）：缺省关闭；置 1 后上传前裁切。
YIBAN_PHOTO_CROP_ENABLE=false

# ---- 编排层（不是 Go 服务端配置）----
# postgres 容器的初始口令；app 的 DSN 由 docker-compose.yml 用它拼出。
# 秘密：必填，本文件留空。
POSTGRES_PASSWORD=
