# ============================================================
# Go 服务端（server/）生产裸机模板：systemd EnvironmentFile。
# ------------------------------------------------------------
# install.sh 把本文件装到 /etc/yiban/server.env.example（0644），
# 运行配置在 /etc/yiban/server.env（0600 root:root），由 install.sh 生成。
# 手工部署时：
#   cp deploy/baremetal/server.env.example /etc/yiban/server.env
#   chmod 600 /etc/yiban/server.env && chown root:root /etc/yiban/server.env
#   生成两个密钥并填进 server.env：
#     openssl rand -hex 32      # YIBAN_HASH_PEPPER
#     openssl rand -base64 32   # YIBAN_CREDENTIAL_KEY
#   systemctl restart yiban.service
#
# 本文件入库：秘密键必须留空，不得写入任何真实值。
# 键面与 server/internal/configdata/registry.json 一致（测试钉住）。
# ============================================================

# ---- 部署 ----
YIBAN_ENV=production
# 必填（秘密）：PostgreSQL 18 DSN。production 缺它即启动失败。
YIBAN_DATABASE_URL=
# production 必须为 0 且留空无意义：置 1 会被启动判据直接拒绝。
YIBAN_ALLOW_NO_DB=0
# 必填（秘密）：openssl rand -hex 32，至少 16 字符。轮换会让审计链断。
YIBAN_HASH_PEPPER=
# 必填（秘密）：openssl rand -base64 32，解码后正好 32 字节。
YIBAN_CREDENTIAL_KEY=
YIBAN_HTTP_ADDR=127.0.0.1:47183
YIBAN_TZ=Asia/Shanghai
YIBAN_INSECURE_COOKIES=false
# 前端构建产物目录（含 index.html）。install.sh --ui-dir 时写这个路径；
# 未装页面（只提供 API）时清空本键，否则服务端因目录缺 index.html 拒绝启动。
YIBAN_UI_DIR=/var/lib/yiban/ui
# 对外基址（绝对 http(s) URL，无尾斜杠）。开启重置邮件时必须是非回环地址。
YIBAN_PUBLIC_BASE_URL=http://127.0.0.1:47183

# ---- 执行体 ----
YIBAN_WORKERS=1
YIBAN_AVG_ATTEMPT_SEC=3
YIBAN_EGRESS_RATE=1.0

# ---- 调度 ----
YIBAN_WINDOW_EDGE_FRONT_SEC=60
YIBAN_WINDOW_EDGE_BACK_SEC=60
YIBAN_ALLOW_TIME_PREF=false
YIBAN_TIME_PREF_COOLDOWN_SEC=30
YIBAN_TASK_LEASE_SEC=120

# ---- 节流 ----
YIBAN_RATE_LIMIT_ENABLE=true
YIBAN_RATE_IP_PER_MIN=60
YIBAN_RATE_IP_BURST=20
YIBAN_RATE_ACCOUNT_PER_MIN=10
YIBAN_RATE_ACCOUNT_BURST=5

# ---- 安全 ----
# 宿主反向代理在回环：只信任 127.0.0.1。代理在别的地址时改成它的 CIDR。
YIBAN_TRUSTED_PROXIES=127.0.0.1
YIBAN_KDF_CONCURRENCY=4
YIBAN_MAX_ACCOUNTS_PER_OWNER=20

# ---- 通知（口令重置邮件）----
YIBAN_RESET_MAIL_ENABLE=false
YIBAN_MAIL_SMTP_HOST=smtp.qq.com
YIBAN_MAIL_SMTP_PORT=465
YIBAN_MAIL_TLS_MODE=auto
# 秘密/联系信息：开启重置邮件时必填，本文件留空。
YIBAN_MAIL_USER=
YIBAN_MAIL_PASS=
YIBAN_MAIL_FROM=

# ---- 图片 ----
# 裸机：systemd 单元只把该目录加入 ReadWritePaths（ProtectSystem=strict）。
# 改这里之后要重跑 install.sh，单元才会按新路径重写；否则服务写不进照片。
YIBAN_PHOTO_DIR=/var/lib/yiban/photos
# 随机安全裁切（每边 0–10%）：缺省关闭；置 1 后上传前裁切。
YIBAN_PHOTO_CROP_ENABLE=false
