# ============================================================
# deploy/web.env —— 部署面 Web 进程参数的**唯一值表**（监听端口 / gunicorn 线程数）
#
# 为什么单独一张表：这些值在六个部署载体里各有一份（web/app.py 的 --port 缺省、
# systemd 单元、supervisord、nginx 两处 proxy_pass、Dockerfile、compose 探活）。
# 它们不能 import Python 常量，也不能互相读对方的文件；过去各写一份，已实测漂移
# （注释写 8、实配 32）。故把值收到本文件，载体只许引用键名：
#   · Python：yiban/adapters/config/loader.py::deploy_value
#   · systemd：web/deploy/yiban-web.service 的 @YIBAN_*@ 占位符（README 命令渲染）
#   · 容器：compose 的 env_file ＋ supervisord 的 %(ENV_*)s ＋ nginx 模板的 envsubst
# 名册 config/registry.json 只登记键的类型/域（default=null），不复制值。
# 守卫：tests/test_deploy_parameterization_gate.py（六载体无字面量、全仓扫描、
# 渲染等值与突变自证）。
#
# 改这里的值 = 改部署行为：
#   · 裸机：按 README「服务器部署」重渲染 systemd 单元，再 daemon-reload + restart；
#   · 容器：docker compose up -d --force-recreate（env_file 只在容器创建时读）。
# ============================================================

# Web 监听端口（仅回环；由 nginx 反代对外，不对公网开放）。
# 选非常见端口，避开 8000/5000/3000 等默认端口，防止与本机其他服务冲突。
YIBAN_WEB_PORT=17892

# gunicorn 线程数（**必须配合 -w 1**：限速/爆破锁定/签到防抖状态存于进程内存，
# 多 worker 各持独立副本会让阈值被轮换请求绕过）。
# 32 是 10 档最小实现（125 §2.3 实测）：每条 SSE 长连接在 gthread 下占一个线程，
# 8 线程时第 9 条连接即饿死全站；32 线程下 10 条 SSE ＋ 普通请求 p50 1.24ms。
# 全局连接上限 min(10, threads-4)（YIBAN_SSE_CONNECTIONS_MAX，缺省 10）给普通请求留线程。
YIBAN_WEB_THREADS=32
