{
  "name": "yiban-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yiban account console UI. React + Vite + TypeScript on the Adminator 4 design language.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "gate:tokens": "node scripts/token-gate.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "verify": "npm run lint && node scripts/token-gate.mjs --self-test && npm run gate:tokens && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
