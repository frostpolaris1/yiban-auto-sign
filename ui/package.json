{
  "name": "yiban-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yiban account console UI. React + Vite + TypeScript on the Adminator 4 design language.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "postinstall": "npm ci --prefix scripts/api-codegen --no-audit --no-fund",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "gate:tokens": "node scripts/token-gate.mjs",
    "gate:structure": "node scripts/structure-gate.mjs",
    "gate:docs": "node scripts/doc-ref-gate.mjs",
    "gate:license": "node scripts/license-gate.mjs",
    "test:unit": "node --import ./scripts/tests/resolve-ts.mjs --test scripts/tests/client.test.mjs scripts/tests/query.test.mjs scripts/tests/accounts.test.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "verify": "npm run lint && npm run check:api && npm run test:unit && node scripts/token-gate.mjs --self-test && npm run gate:tokens && node scripts/structure-gate.mjs --self-test && npm run gate:structure && node scripts/doc-ref-gate.mjs --self-test && npm run gate:docs && node scripts/license-gate.mjs --self-test && npm run gate:license && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
