# ============================================================
# Go 服务端（server/）开发环境模板。旧 Python 栈用仓库根 .env.example。
# ------------------------------------------------------------
# 用法：
#   cp server/.env.example server/.env
#   生成两个密钥并填进 server/.env：
#     openssl rand -hex 32      # YIBAN_HASH_PEPPER
#     openssl rand -base64 32   # YIBAN_CREDENTIAL_KEY
#   set -a; . server/.env; set +a
#
# 本文件入库：秘密键必须留空，不得写入任何真实值。
# 键面与 server/internal/configdata/registry.json 一致（测试钉住）。
# ============================================================

# ---- 部署 ----
YIBAN_ENV=development
# 必填（秘密）：PostgreSQL DSN。留空时靠下面的 YIBAN_ALLOW_NO_DB=1 无库启动，
# 业务端点回 501；要跑真实业务请填 DSN 并把 YIBAN_ALLOW_NO_DB 改为 0。
YIBAN_DATABASE_URL=
# 开发态显式允许无库启动。production 拒绝本键。
YIBAN_ALLOW_NO_DB=1
# 必填（秘密）：openssl rand -hex 32，至少 16 字符。
YIBAN_HASH_PEPPER=
# 必填（秘密）：openssl rand -base64 32，解码后正好 32 字节。
YIBAN_CREDENTIAL_KEY=
YIBAN_HTTP_ADDR=127.0.0.1:47183
YIBAN_TZ=Asia/Shanghai
# 本地 HTTP（无 TLS）必须发非 Secure cookie；development 缺省已是 true。
YIBAN_INSECURE_COOKIES=true
# 前端构建产物目录（含 index.html）。空表示只提供 API；
# 本地联调页面时在仓库根执行 npm --prefix ui run build，再填 ../ui/dist。
YIBAN_UI_DIR=
# 合规文档目录（CHANGELOG.md、USER_AGREEMENT.md、PRIVACY_POLICY.md）。
# 空表示未提供：/api/changelog 回「暂无更新日志」，/terms 与 /privacy 回占位页。
# 本地联调时填仓库根（..）。
YIBAN_DOCS_DIR=
# 口令重置链接基址。开发态指向本进程；开启重置邮件时必须改成非回环地址。
YIBAN_PUBLIC_BASE_URL=http://127.0.0.1:47183

# ---- 执行体 ----
YIBAN_WORKERS=1
YIBAN_AVG_ATTEMPT_SEC=3
YIBAN_EGRESS_RATE=1.0

# ---- 调度 ----
YIBAN_WINDOW_EDGE_FRONT_SEC=60
YIBAN_WINDOW_EDGE_BACK_SEC=60
YIBAN_ALLOW_TIME_PREF=false
YIBAN_TIME_PREF_COOLDOWN_SEC=30
YIBAN_TASK_LEASE_SEC=120

# ---- 节流 ----
YIBAN_RATE_LIMIT_ENABLE=true
YIBAN_RATE_IP_PER_MIN=60
YIBAN_RATE_IP_BURST=20
YIBAN_RATE_ACCOUNT_PER_MIN=10
YIBAN_RATE_ACCOUNT_BURST=5

# ---- 安全 ----
# 可信反向代理 CIDR 表（逗号分隔）。空表示不信任 X-Forwarded-For。
YIBAN_TRUSTED_PROXIES=
YIBAN_KDF_CONCURRENCY=4

# ---- 通知（口令重置邮件）----
YIBAN_RESET_MAIL_ENABLE=false
YIBAN_MAIL_SMTP_HOST=smtp.qq.com
YIBAN_MAIL_SMTP_PORT=465
YIBAN_MAIL_TLS_MODE=auto
# 秘密/联系信息：开启重置邮件时必填，本文件留空。
YIBAN_MAIL_USER=
YIBAN_MAIL_PASS=
YIBAN_MAIL_FROM=

# ---- 通知（webhook 推送，serverchan/custom）----
# 旧线 YIBAN_NOTIFY_* 不兼容不迁移。
YIBAN_WEBHOOK_ENABLE=false
YIBAN_WEBHOOK_TYPE=serverchan
# 秘密：serverchan 填 SendKey；custom 填完整 webhook URL。
# 不进日志、审计与错误文本；本文件留空。
YIBAN_WEBHOOK_SECRET=
YIBAN_WEBHOOK_COOLDOWN_SEC=60
YIBAN_WEBHOOK_DAILY_MAX=5

# ---- 图片 ----
# 随机安全裁切（每边 0–10%）：缺省关闭；置 1 后上传前裁切。
YIBAN_PHOTO_CROP_ENABLE=false
YIBAN_PHOTO_DIR=data/photos
