# ===== 必填：易班账号 =====
# 方式一（推荐，服务器端）：使用 TUI 配置工具生成 accounts.json
#   python3 -m tui   # 表单式输入账号密码识别码，一个账号一次输完
# 方式二（多账号，结构化 JSON，一次输入一个账号完整信息）：
# YIBAN_ACCOUNTS_JSON=[{"phone":"13800138000","password":"pwd","phone_model":"Vivo-XXXX","phone_code":"xxxx..."}]
# 方式三（旧格式，多个账号用 # 分隔，账号与密码用 : 分隔，向后兼容）
# YIBAN_ACCOUNTS=13800138000:your_password#13900139000:another_password

# 方式四（单账号，向后兼容）
YIBAN_PHONE=13800138000
YIBAN_PASSWORD=your_password

# ===== 可选：账号密码加密密钥（强烈建议配置，缺失时自动生成写入 .env）=====
# accounts.json/yiban.db 的 password/phone_code 以 AES-GCM 密文对象落盘，解密依赖此密钥；
# 优先级：环境变量 YIBAN_ACCOUNTS_KEY > .env 同键 > 自动生成（chmod 600）。
# ⚠️ 密钥丢失 = 已加密账号密码不可恢复：备份必须包含密钥（与数据分开放）。
# YIBAN_ACCOUNTS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== 可选：随机延迟（防风控纵深防御，默认关闭）=====
# 启动后随机等待 0~60 秒再开始首个签到（非自动错峰模式；错峰模式由调度计划决定）
# YIBAN_START_DELAY_MAX=60
# 非错峰模式账号间随机间隔 0~10 秒
# YIBAN_ACCOUNT_GAP_MAX=10

# ===== 可选：调度 v2（自动错峰；2×2 组合，2026-08-15 起默认启用）=====
# 排序 × 分布（order × dist）：sequence/random × uniform/normal
# 四组合：顺序×均匀=固定序线性填块；随机×均匀=每天打乱铺满；顺序×正态=固定作息钟形；
#         随机×正态=每天重排钟形（防风控最强）
# 旧参数 YIBAN_SIGN_MODE（sequence/random/normal）自动映射为组合，新参数优先。
YIBAN_SIGN_ORDER=sequence
YIBAN_SIGN_DIST=uniform
# 签到窗口（HH:MM，需开始早于结束；设置页可改）
# YIBAN_SIGN_START=06:30
# YIBAN_SIGN_END=07:50
# 掐头去尾（0.22.0 起前后独立，秒，0~300 且 30 的倍数 = 0.5 分钟粒度；0=不裁切）。
# 有效窗口 = [START + 前裁, END - 后裁]；设置页可改（旧键 YIBAN_WINDOW_EDGE_SEC 仍兼容，
# 自动映射为前后对称，保存设置后迁移为新键）
# YIBAN_WINDOW_EDGE_FRONT_SEC=60
# YIBAN_WINDOW_EDGE_BACK_SEC=60
# 块容量（每 5 分钟块最多账号数，满则向后顺延；默认 15）
# YIBAN_BLOCK_CAP=15
# 正态高峰中心范围（有效窗口相对位置 %，窄漂移保账号作息稳定）
# YIBAN_SCHEDULE_MU_MIN_PCT=40
# YIBAN_SCHEDULE_MU_MAX_PCT=60
# 正态分散程度范围（有效窗口宽度 %）
# YIBAN_SCHEDULE_SIGMA_MIN_PCT=15
# YIBAN_SCHEDULE_SIGMA_MAX_PCT=25
# 压缩模式间隔下限（分钟）
# YIBAN_MIN_EXEC_GAP=5
# 容量预检：单次执行平均耗时估算（秒）
# YIBAN_AVG_ATTEMPT_SEC=8
# 同一账号两次尝试最短间隔（秒）
# YIBAN_RETRY_MIN_INTERVAL=60
# 启动对齐：已过点账号相邻最小执行间隔（秒）
# YIBAN_EXEC_GAP_MIN=10
# 用户自选时间片总开关（0=关默认；1=开启后普通用户可在设置页选 5 分钟时间片）
# YIBAN_ALLOW_TIME_PREF=0
# 自选时间片切换冷却（弹性：60 秒窗口内前 20 次切换自由，"全点一遍再定"正常；
# 超出后冷却递增 30s→60s→120s→…封顶 300s，持续高频才被压制；0=关闭）
# YIBAN_TIME_PREF_COOLDOWN_SEC=30
# 用户自暂停冷却（仅"暂停"计冷却，固定间隔；"恢复"不限——恢复是紧迫正向操作；
# 防连点/防刷屏噪音，非安全边界；0=关闭）
# YIBAN_PAUSE_COOLDOWN_SEC=30

# ===== 可选：容量上限（人数超负载兜底，2026-08-15 补）=====
# 注册用户总数上限（0=不限；默认 200，一人一号 ≈ 200 账号）
# YIBAN_MAX_USERS=200
# 账号总数上限（0=不限；默认 500 ≈ 签到窗口理论可承载上限留裕量）
# YIBAN_MAX_ACCOUNTS=500

# ===== 可选：周日签到 =====
# 0=关闭（默认，周日不签到）；1=开启（周日也尝试签到）
# YIBAN_SUNDAY_SIGN=0

# ===== 可选：周六签到 =====
# 1=开启（默认，周六照常签到）；0=关闭（周六不签到）
# YIBAN_SATURDAY_SIGN=1

# ===== 可选：账号配置文件路径（仅 JSON→SQLite 自动迁移来源）=====
# 默认 ./accounts.json（users.json 由同目录推断）；0.17+ 数据存于 yiban.db，
# 此文件仅首次迁移时读取（迁移后改名 .bak 保留逃生门）
# YIBAN_ACCOUNTS_FILE=./accounts.json

# ===== 可选：设备绑定（学校开启了"授权设备"校验时必填）=====
# 设备型号和唯一识别码，可通过易班 App 内扫获取工具页获取
# YIBAN_PHONE_MODEL=Vivo-XXXX
# YIBAN_PHONE_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选：消息推送（Webhook，v0.26.0；与邮件通知互不影响）=====
# 类型：serverchan（Server酱/方糖服务号）/ custom（自定义地址）/ 空=关闭
# YIBAN_NOTIFY_TYPE=serverchan
# 密钥（SendKey 或自定义 URL）经 AES-GCM 加密后写入 YIBAN_NOTIFY_SECRET_ENC，
# 推荐在「系统设置 → 消息推送」页配置（自动加密落盘），无需手填。
# ⚠️ SendKey 属敏感凭据：只填服务器本地 .env，勿提交仓库/勿进 Docker 镜像
# 同类型告警节流秒数（默认 60；0=关闭）
# YIBAN_NOTIFY_COOLDOWN=60
# 仅推送重要告警：1=只推安全与系统级告警（登录暴力破解/高危操作/权限变更/审计链异常/
# 时钟跳变/容量触顶/主管理员自助改密等），用户日常改密、签到结果类仅走邮件，不占每日额度
# YIBAN_NOTIFY_URGENT_ONLY=1
# 非紧急告警每日上限（默认 5，匹配 Server酱 免费版 5 条/天；0=不限；
# 自定义 Webhook 无此限制，建议按需调大或设 0）
# YIBAN_NOTIFY_DAILY_MAX=5
# 紧急（urgent）告警每日上限（默认 3；0=不限）：与非紧急分账，避免噪声/暴力破解
# 类告警把当日额度烧完后，审计链异常等真告警在手机端被静默吞掉（批次14 P2-1）
# YIBAN_NOTIFY_URGENT_DAILY_MAX=3
# 兼容旧配置：直接填完整 webhook URL 仍可用（按 custom 处理）
# YIBAN_NOTIFY_URL=https://sctapi.ftqq.com/YOUR_SENDKEY.send

# ===== 可选：邮箱通知（SMTP 管理员告警邮件；不配置则不启用，不影响上方的 webhook）=====
# 0=关闭（默认）；1=开启（需同时配置 USER/PASS/ADMIN_TO 才生效）
# YIBAN_MAIL_ENABLE=0
# SMTP 服务器与端口（默认 smtp.qq.com:465；465 走 SSL，其它端口自动 STARTTLS）
# YIBAN_MAIL_SMTP_HOST=smtp.qq.com
# YIBAN_MAIL_SMTP_PORT=465
# 发件邮箱（QQ 邮箱需在网页「设置→账户→开启 SMTP 服务」后使用授权码，不是登录密码）
# ⚠️ 授权码属敏感凭据：只填服务器本地 .env，勿提交仓库/勿进 Docker 镜像
# YIBAN_MAIL_USER=your@qq.com
# YIBAN_MAIL_PASS=你的QQ邮箱授权码
# 管理员告警邮件收件人（逗号分隔支持多个）
# YIBAN_MAIL_ADMIN_TO=your@qq.com
# 主管理员个人收件开关：1=接收（默认）；0=关闭后不再收发到 ADMIN_TO 的告警（普通管理员照常收）
# YIBAN_MAIL_ADMIN_NOTIFY=1
# 用户签到失败提醒每账号每日上限（v0.24.3 起「定时/手动/探针」三个入口统一计算；
# 发送成功才消耗额度）。0 或负数=不限频（恢复旧行为）
# YIBAN_MAIL_USER_FAIL_DAILY_CAP=1

# ===== 可选：账号健康检查（探针模式 + 注册时验证，v0.23.x）=====
# 注册/添加账号时即时验证（登录+拉任务，不实际签到）：0=关闭（默认）；1=开启（验证失败当场打回）
# YIBAN_ACCOUNT_VERIFY=0
# 探针模式：非签到时段对全部账号做只读健康检查，提前发现图形验证墙/校本化失效等无法自愈问题并邮件预警。
# 需配合每日一次 cron/调度任务（服务器 run_probe.sh 或容器 scheduler.py），脚本内按以下配置自行判断是否触发。
# 开启：0=关闭（默认）；1=开启
# YIBAN_PROBE_ENABLE=0
# 触发时间（HH:MM，每天该时刻起本次调度任务触发探测）
# YIBAN_PROBE_TIME=20:00
# 触发频率：正整数=每 N 天；once=下一次计划时间单次执行（执行后自动关闭探针）
# YIBAN_PROBE_INTERVAL_DAYS=1
# 会话绝对过期上限天数（Web 登录会话自登录起最多存活 N 天，防盗号 Cookie 永久续命；
# 越界自动回退默认并告警）
# YIBAN_SESSION_ABS_DAYS=7

# ===== 可选：登录方式（一般无需修改）=====
# 默认使用 fyiban 同款真实 App 特征登录；设为 1 时切回旧 iOS 伪造 UA 流程
# （GitHub Actions 等特殊场景备选；易班风控变更后旧流程可能失效）
# YIBAN_LEGACY_LOGIN=0

# ===== 可选：Web 管理端 =====
# 管理员账号（首次启动自动生成 SECRET_KEY 写入 .env；改密后明文可清除）
# YIBAN_ADMIN_USER=admin
# YIBAN_ADMIN_PASSWORD=your_password
# 全局公告（设置页可改；等价于 YIBAN_ANNOUNCEMENT）
# YIBAN_ANNOUNCEMENT=
# 会话 Cookie Secure 标志：生产环境经 HTTPS 反代时建议设为 1，强制浏览器仅经 HTTPS 发送；
# 默认 0（兼容 HTTP 直连）；非回环地址且未开启时应用启动会打印强警告。
# YIBAN_COOKIE_SECURE=0
# 数据库/环境文件路径（默认相对路径，无需修改；users.json 无需配置——由 accounts.json 同目录推断）
# YIBAN_DB_FILE=yiban.db
# YIBAN_ENV_FILE=.env

# ===== 可选：状态文件与日志 =====
# 按日状态文件目录（sign-state-YYYY-MM-DD.json / cred-state.json）
# YIBAN_STATE_DIR=/var/log/yiban
# 日志目录（0.19.5 起按天分文件：sign-YYYY-MM-DD.log，此值提供目录；保留 365 天由 scripts/yiban-cleanup.sh 清理）
# YIBAN_LOG_FILE=/var/log/yiban/sign.log
# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO（非法值回退 INFO，不回退 DEBUG）
# YIBAN_LOG_LEVEL=INFO
# 单次签到总超时（秒；run.sh 使用，默认动态计算 = 签到窗口结束 + 5 分钟余量，下限 600；显式设置时优先）
# YIBAN_RUN_TIMEOUT_SEC=1800

# ===== 可选：网络代理（GitHub Actions 等出口被地域风控时）=====
# YIBAN_PROXY=http://127.0.0.1:7890

# ===== 可选：网站备案信息 =====
# 留空则不显示（默认，footer 保持旧样式）；填写后显示在所有页面底部（登录页/用户页/管理页）。
# ICP 备案与公安备案分别独立预留位（公安备案键 YIBAN_POLICE_INFO 支持 v0.22.3+）。
# 如：YIBAN_ICP_INFO=苏ICP备XXXXXXXX号
# 如：YIBAN_POLICE_INFO=苏公网安备3201XXXXXXXX号
# YIBAN_ICP_INFO=
# YIBAN_POLICE_INFO=
