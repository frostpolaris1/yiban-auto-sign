# ===== 必填：易班账号 =====
# 方式一（推荐，服务器端）：使用 TUI 配置工具生成 accounts.json
#   python3 -m tui   # 表单式输入账号密码识别码，一个账号一次输完
# 方式二（多账号，结构化 JSON，一次输入一个账号完整信息）：
# YIBAN_ACCOUNTS_JSON=[{"phone":"13800138000","password":"pwd","phone_model":"Vivo-XXXX","phone_code":"xxxx..."}]
# 方式三（旧格式，多个账号用 # 分隔，账号与密码用 : 分隔，向后兼容）
# YIBAN_ACCOUNTS=13800138000:your_password#13900139000:another_password

# 方式四（单账号，向后兼容）
YIBAN_PHONE=13800138000
YIBAN_PASSWORD=your_password

# ===== 可选：并发设置（仅服务器端多账号场景）=====
# 默认 1（顺序执行，最稳妥）；>1 为并发线程数（如 3 表示 3 个账号同时签到）
# 注意：并发请求可能触发易班风控，建议保持默认顺序执行
# YIBAN_CONCURRENCY=1

# ===== 可选：随机延迟（防风控纵深防御，默认关闭）=====
# 启动后随机等待 0~60 秒再开始首个签到，打散"每天固定秒级执行"的脚本特征
# YIBAN_START_DELAY_MAX=60
# 顺序模式账号间随机间隔 0~10 秒（并发模式无效果）
# YIBAN_ACCOUNT_GAP_MAX=10

# ===== 可选：账号密码加密密钥（强烈建议配置，缺失时自动生成写入 .env）=====
# accounts.json 的 password/phone_code 以 AES-GCM 密文对象落盘，解密依赖此密钥；
# 优先级：环境变量 YIBAN_ACCOUNTS_KEY > .env 同键 > 自动生成（chmod 600）。
# ⚠️ 密钥丢失 = 已加密账号密码不可恢复：备份必须包含密钥（与数据分开放）。
# YIBAN_ACCOUNTS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== 可选：账号配置文件路径（TUI 工具生成的 accounts.json）=====
# 默认 ./accounts.json，signin.py 启动时自动读取；无需修改
# YIBAN_ACCOUNTS_FILE=./accounts.json

# ===== 可选：设备绑定（学校开启了"授权设备"校验时必填）=====
# 设备型号和唯一识别码，可通过易班 App 内扫获取工具页获取
# YIBAN_PHONE_MODEL=Vivo-XXXX
# YIBAN_PHONE_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选：消息通知 =====
# 支持 Server 酱 / Bark / 企业微信等 webhook URL
# YIBAN_NOTIFY_URL=https://sctapi.ftqq.com/YOUR_SENDKEY.send

# ===== 可选：日志级别 =====
# 支持 DEBUG / INFO / WARNING / ERROR，默认为 DEBUG（详细模式，方便排查）
# YIBAN_LOG_LEVEL=DEBUG
