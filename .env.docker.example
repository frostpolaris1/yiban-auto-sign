# ============================================================
# 易班自动签到 - Docker 部署配置模板
# 用法：mkdir -p data && cp .env.docker.example data/.env
#       然后编辑 data/.env 填入你自己的配置。
# ⚠️ 不要在本模板里写真实账号/密码；它会被提交进仓库，属公开内容。
# ============================================================

# ---- 必填：Web 管理员（首次登录后台用）----
# ⚠️ 必须改成你自己的强密码（≥8 位）：保持默认字面量或弱口令时，应用会拒绝启动。
YIBAN_ADMIN_USER=admin
YIBAN_ADMIN_PASSWORD=请修改为强密码

# ---- 可选：消息通知（Server酱 / Bark / 企业微信 webhook）----
# YIBAN_NOTIFY_URL=

# ---- 可选：邮箱通知（SMTP 管理员告警邮件；不配置则不启用）----
# YIBAN_MAIL_ENABLE=0
# YIBAN_MAIL_SMTP_HOST=smtp.qq.com
# YIBAN_MAIL_SMTP_PORT=465
# YIBAN_MAIL_USER=your@qq.com
# YIBAN_MAIL_PASS=你的QQ邮箱授权码（敏感凭据，只填 data/.env，勿写本模板）
# YIBAN_MAIL_ADMIN_TO=your@qq.com
# YIBAN_MAIL_ADMIN_NOTIFY=1

# ---- 可选：账号健康检查（探针模式 + 注册时验证，v0.23.x）----
# 注册/添加账号时即时验证（登录+拉任务，不实际签到）：1=开启（验证失败当场打回）
# YIBAN_ACCOUNT_VERIFY=0
# 探针模式：非签到时段对全部账号做只读健康检查，异常邮件预警；容器 scheduler.py
# 每 10 分钟尝试一次（未开启不启动子进程），实际执行时刻由下方触发时间决定——
# 该时刻后的第一个尝试周期，设置页改时间即时生效。开启：1=开启
# YIBAN_PROBE_ENABLE=0
# 触发时间（HH:MM，该时刻后的第一个调度周期触发探测；调度器周期尝试，无需改调度）
# YIBAN_PROBE_TIME=20:00
# 触发频率：正整数=每 N 天；once=下一次计划时间单次执行（执行后自动关闭）
# YIBAN_PROBE_INTERVAL_DAYS=1

# ---- 可选：日志级别（DEBUG / INFO / WARNING / ERROR，默认 INFO）----
# YIBAN_LOG_LEVEL=INFO

# ---- 可选：周日是否签到（1=签，0=不签，默认不签）----
# YIBAN_SUNDAY_SIGN=0

# ---- 可选：周六是否签到（1=签，0=不签，默认签）----
# YIBAN_SATURDAY_SIGN=1

# ---- 可选：签到窗口（默认 06:30–07:50）----
# YIBAN_SIGN_START=06:30
# YIBAN_SIGN_END=07:50

# ---- 可选：签到调度（批次14 C4 补齐；完整清单见 .env.example）----
# 排序方式：sequence=列表顺序（默认）/ random=每天打乱
# YIBAN_SIGN_ORDER=sequence
# 分布方式：uniform=均匀（默认）/ normal=钟形高峰
# YIBAN_SIGN_DIST=uniform
# 窗口首尾缓冲（秒，0~300，30 的倍数）：前裁/后裁独立
# YIBAN_WINDOW_EDGE_FRONT_SEC=60
# YIBAN_WINDOW_EDGE_BACK_SEC=60
# 错峰分块容量（每块最多人数，默认 15）
# YIBAN_BLOCK_CAP=15
# 用户自选时间片总开关：1=开启（默认关）
# YIBAN_ALLOW_TIME_PREF=0
# 随机延迟（秒）：启动延迟 / 账号间隔（默认关）
# YIBAN_START_DELAY_MAX=0
# YIBAN_ACCOUNT_GAP_MAX=0

# ---- 可选：容量上限（默认 500 用户 / 200 账号；0=不限）----
# YIBAN_MAX_USERS=500
# YIBAN_MAX_ACCOUNTS=200

# ---- 可选：会话安全（生产经容器内 nginx HTTPS 反代，compose 已注入=1）----
# YIBAN_COOKIE_SECURE=1
# 会话绝对过期天数（1~30，默认 7）
# YIBAN_SESSION_ABS_DAYS=7

# ---- 可选：消息推送（Server酱 Turbo / 自定义地址，批次11 组件）----
# 类型：serverchan=Server酱 / custom=自定义地址 / 留空=关闭
# YIBAN_NOTIFY_TYPE=
# 密钥：Server酱 SendKey（SCT 开头）或自定义地址（保存后加密落盘，不回显）
# YIBAN_NOTIFY_SECRET_ENC=
# 同类型节流秒数（0=关闭，默认 60）
# YIBAN_NOTIFY_COOLDOWN=60
# 仅推送重要告警（非紧急仅走邮件）：1=开启
# YIBAN_NOTIFY_URGENT_ONLY=0
# 每日上限：非紧急账（默认 5）/ 紧急账（默认 3）；0=不限
# YIBAN_NOTIFY_DAILY_MAX=5
# YIBAN_NOTIFY_URGENT_DAILY_MAX=3

# ---- 可选：认证代理（如 TinyProxy / Squid，出口被地域风控时使用）----
# YIBAN_PROXY=http://宿主机IP:端口

# ---- 可选：网站备案信息（留空则不显示）----
# YIBAN_ICP_INFO=京ICP备XXXXXXXX号-1
# YIBAN_POLICE_INFO=