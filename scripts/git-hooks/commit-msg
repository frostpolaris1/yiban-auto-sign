#!/bin/bash
# commit-msg hook：校验提交信息符合 Conventional Commits 格式（可选流程，默认未启用）
# 启用方式（本地执行一次，不修改仓库代码）：
#   git config core.hooksPath scripts/git-hooks
# 跳过本次校验：git commit --no-verify

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# type(scope): subject / type!: subject / type(scope)!: subject
# type 白名单含 release（发布提交），与 WORKFLOW 发布流程对应
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  echo "提交信息不符合 Conventional Commits 规范" >&2
  echo "格式: <type>(<scope>): <subject>" >&2
  echo "type: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release" >&2
  echo "示例: fix(login): 空密码导致 500" >&2
  echo "如需跳过本次校验: git commit --no-verify" >&2
  exit 1
fi
exit 0
